<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <RootNamespace>Jellyfin.Plugin.NetflixUI</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.NetflixUI</AssemblyName>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Jellyfin 10.11.x targets net9.0. These are compile-time only; the server
         supplies them at runtime, so they must NOT be copied to the output. -->
    <PackageReference Include="Jellyfin.Controller" Version="10.11.*" Private="false" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Model" Version="10.11.*" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <!-- Web assets and the config page are served straight out of the assembly,
         so the plugin stays a single self-contained dll. -->
    <EmbeddedResource Include="Configuration\configPage.html" />
    <EmbeddedResource Include="Web\netflix-ui.js" />
    <EmbeddedResource Include="Web\netflix-ui.css" />
  </ItemGroup>

</Project>

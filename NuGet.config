<?xml version="1.0" encoding="utf-8"?>
<!--
  Repo-local NuGet settings.

  The machine-level NuGet.Config on some dev boxes enables packageSourceMapping
  with a narrow allowlist, which makes every package outside that list fail to
  restore ("NU1100 ... PackageSourceMapping is enabled"). Clearing and
  redeclaring here keeps this repo buildable regardless of machine config, and
  behaves identically in CI.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
</configuration>
